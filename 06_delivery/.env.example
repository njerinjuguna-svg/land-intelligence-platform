# Copy to .env and fill in. .env is NEVER committed.
#
# The widget needs a database user that can SELECT the intelligence and
# INSERT its own usage rows - and nothing else. Do NOT reuse the postgres
# superuser the ETL runs as: this is the one component reachable from the
# public internet, and it should not be able to rewrite a parcel.
#
#   CREATE USER landiq_api WITH PASSWORD '...';
#   GRANT USAGE ON SCHEMA land, analytics, clients, logs TO landiq_api;
#   GRANT SELECT ON land.parcels, analytics.parcel_intelligence,
#                   analytics.suitability_scores, clients.api_keys,
#                   clients.companies, clients.branding TO landiq_api;
#   GRANT INSERT ON logs.api_logs TO landiq_api;
#   GRANT INSERT, UPDATE ON clients.api_usage TO landiq_api;

DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=land_intelligence_kenya
DB_USER=landiq_api
DB_PASSWORD=

# Satellite view and Street View. Leave BLANK and the widget shows a neutral
# placeholder instead - it never breaks for want of a key.
#
# The server fetches these pictures and streams the bytes; the parcel's
# coordinate is never sent to a client's browser (rules A4/B4). Images are
# cached under 06_delivery/cache/img so Google is billed once per plot rather
# than once per page view.
#
# In the Google Cloud console you need, on a project with billing enabled:
#   - Maps Static API          (the satellite picture)
#   - Street View Static API   (the street view, where it exists)
# Restrict the key to those two APIs. An IP restriction is not usable on
# Stage 0, because a tunnel changes address - add one when there is a server.
GOOGLE_MAPS_KEY=
