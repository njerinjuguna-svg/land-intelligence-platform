# Copy to .env and fill in. .env is NEVER committed.
#
# The widget needs a database user that can SELECT the intelligence and
# INSERT its own usage rows - and nothing else. Do NOT reuse the postgres
# superuser the ETL runs as: this is the one component reachable from the
# public internet, and it should not be able to rewrite a parcel.
#
#   CREATE USER landiq_api WITH PASSWORD '...';
#   GRANT USAGE ON SCHEMA land, analytics, clients, logs TO landiq_api;
#   GRANT SELECT ON land.parcels, analytics.parcel_intelligence,
#                   analytics.suitability_scores, clients.api_keys,
#                   clients.companies, clients.branding TO landiq_api;
#   GRANT INSERT ON logs.api_logs TO landiq_api;
#   GRANT INSERT, UPDATE ON clients.api_usage TO landiq_api;

DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=land_intelligence_kenya
DB_USER=landiq_api
DB_PASSWORD=
